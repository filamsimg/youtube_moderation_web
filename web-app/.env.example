GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=rahasia-moderasi-judol
NEXTAUTH_URL=http://localhost:3000
MODEL_API_BASE=http://localhost:5000

# NEON SERVERLESS POSTGRESQL CONFIGURATION (https://neon.tech)
# Salin dari tombol 'Connect' di dashboard Neon Anda (pilih DB: Athena Shield)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/Athena%20Shield?sslmode=require"

# MIDTRANS CONFIGURATION (SANDBOX)
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ADMIN CONFIGURATION
# Daftar email yang akan otomatis mendapatkan role 'superadmin' saat pertama kali login (pisahkan dengan koma jika lebih dari satu)
ADMIN_EMAILS=superadmin1@gmail.com,superadmin2@gmail.com
# HUGGING FACE SPACES CONFIGURATION
HF_SPACE_ID=filamss/athena_shield_model
HF_ACCESS_TOKEN= # Hanya diperlukan jika Space Hugging Face Anda diset sebagai Private
